# API Configuration
# Set VITE_USE_REMOTE_API to "true" to enable remote API calls.
# When false or missing, the app uses local data from src/data/products.ts.
VITE_USE_REMOTE_API=false

# Base URL for remote API (only used if VITE_USE_REMOTE_API is true)
VITE_API_BASE_URL=https://api.example.com

# Development: to enable remote API locally, use:
# VITE_USE_REMOTE_API=true VITE_API_BASE_URL=http://localhost:3001 npm run dev
